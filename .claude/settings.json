{
  "permissions": {
    "allow": [
      "Bash(node -e ' *)",
      "Bash(curl -sI --max-time 10 \"https://www.zenscrollapp.com\")",
      "Bash(curl -sI --max-time 10 \"https://zenscrollapp.com\")",
      "Bash(timeout 20 node -e ' *)",
      "Bash(npm uninstall *)",
      "Bash(grep -iE \"\\\\.\\(png|jpg|jpeg|webp|gif\\)$\")"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/status-sync.mjs\"",
            "timeout": 90
          }
        ]
      }
    ]
  }
}
